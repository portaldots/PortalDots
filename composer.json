{
    "name": "portal-dots/portaldots",
    "description": "",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "cebe/markdown": "^1.2.1",
        "ezyang/htmlpurifier": "^4.9",
        "guzzlehttp/guzzle": "^8.2",
        "koel/dotenv-editor": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/legacy-factories": "^1.4.2",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "maatwebsite/excel": "^4.0",
        "simplesoftwareio/simple-qrcode": "~4",
        "spatie/laravel-activitylog": "^4.12.3",
        "spatie/laravel-permission": "^8.3",
        "vlucas/phpdotenv": "^5.4.1"
    },
    "require-dev": {
        "fruitcake/laravel-debugbar": "^4.4",
        "fakerphp/faker": "^1.20.0",
        "laravel/pint": "^1.2",
        "laravel/sail": "^1.21",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.9",
        "phpmd/phpmd": "*",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpcs": [
            "phpcs --standard=phpcs.xml ./"
        ],
        "phpcs-github-actions": [
            "phpcs -q --report=checkstyle ./ | cs2pr"
        ],
        "phpcbf": [
            "phpcbf --standard=phpcs.xml ./"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
